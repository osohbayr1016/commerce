# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL (required for sitemap, robots, OAuth callbacks)
NEXT_PUBLIC_SITE_URL=https://maayaauvuu.com

# Cloudflare R2 (for image uploads)
CLOUDFLARE_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=commerceq
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# Gmail OTP (for passwordless login)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# Optional: Hero fallback when Supabase is down
# NEXT_PUBLIC_HERO_FALLBACK_IMAGE_URL=https://your-cdn.com/default-banner.jpg

# Optional: Cloudflare Images API
# CLOUDFLARE_IMAGES_API_TOKEN=your-token

# Optional: Sentry error tracking
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# QPay (sandbox by default)
# Root URL, NOT including /v2
QPAY_BASE_URL=https://merchant-sandbox.qpay.mn
QPAY_CLIENT_ID=your-qpay-username
QPAY_CLIENT_SECRET=your-qpay-password
QPAY_INVOICE_CODE=YOUR_INVOICE_CODE
